{
  "name": "shiftbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3000",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:goldens": "vitest run --project goldens",
    "test:proposed": "vitest run --project proposed",
    "test:e2e": "playwright test",
    "hooks:test": "bash .claude/hooks/tests/run.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:samples": "tsx scripts/generate-demo-samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@base-ui/react": "^1.9.0",
    "@napi-rs/canvas": "^1.0.11",
    "@react-pdf/renderer": "^4.9.0",
    "@shiftbook/rules": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "geist": "^1.7.2",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.5",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
